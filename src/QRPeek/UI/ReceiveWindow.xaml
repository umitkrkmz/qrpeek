<Window x:Class="QRPeek.UI.ReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QRPeek"
        Style="{StaticResource WindowBase}"
        Title="{x:Static local:S.ReceiveFromPhone}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/QRPeek.ico">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="Heading" Text="{x:Static local:S.RecvScanHint}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- 1. Waiting: the QR -->
        <Border x:Name="QrCard" Style="{StaticResource Card}" Background="White" Padding="12" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="300" Height="300" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <!-- 2. A device connected: who, and the match code -->
        <Border x:Name="DeviceCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,12,0,4">
                    <TextBlock Text="{x:Static local:S.RecvCode}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock x:Name="CodeText" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{x:Static local:S.RecvCodeHint}" Style="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <!-- 3. The phone sent a list: approve or reject -->
        <Border x:Name="OfferCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,12,0,0" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
            <StackPanel>
                <TextBlock x:Name="OfferTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="OfferList" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" />
                <Border x:Name="RiskyBox" Background="{DynamicResource WarnBg}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Warn}" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{x:Static local:S.RecvRisky}" Foreground="{DynamicResource Warn}" FontSize="12.5" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="SpaceText" Text="{x:Static local:S.RecvNoSpace}" Foreground="{DynamicResource Bad}" FontSize="12.5" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,8,0,0" />
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <Button x:Name="AcceptButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{x:Static local:S.Accept}" Click="OnAccept" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="{x:Static local:S.Reject}" Click="OnReject" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="NoteText" Style="{StaticResource Muted}" Margin="0,10,0,0" />

        <DockPanel x:Name="StatusRow" Margin="0,10,0,0">
            <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="NoWrap" />
            <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" />

        <DockPanel Margin="0,14,0,0">
            <Button x:Name="ChangeFolderButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{x:Static local:S.ChangeFolder}"
                    Click="OnChangeFolder" Padding="6,2" FontSize="12.5" />
            <TextBlock Text="{x:Static local:S.RecvFolder}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="NoWrap" />
            <TextBlock x:Name="FolderText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="ShowFolderButton" DockPanel.Dock="Left" Click="OnShowInFolder" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static local:S.ShowInFolder}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{x:Static local:S.Close}" Click="OnClose" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
