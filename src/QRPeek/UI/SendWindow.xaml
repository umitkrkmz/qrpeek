<Window x:Class="QRPeek.UI.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QRPeek"
        Style="{StaticResource WindowBase}"
        Title="{x:Static local:S.SendToPhone}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual" AllowDrop="True"
        Icon="pack://application:,,,/Assets/QRPeek.ico">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="Heading" Text="{x:Static local:S.SendScanHint}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- QR (text or LAN link) -->
        <Border x:Name="QrCard" Style="{StaticResource Card}" Background="White" Padding="12" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="300" Height="300" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <!-- Empty state -->
        <Border x:Name="EmptyCard" Visibility="Collapsed" Height="200">
            <Grid>
                <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource Line}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,10" />
                    <TextBlock Text="{x:Static local:S.SendEmpty}" Style="{StaticResource Muted}" FontSize="13.5" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="WhatText" FontSize="13.5" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" MaxHeight="60" />
        <TextBlock x:Name="NoteText" Style="{StaticResource Muted}" Margin="0,6,0,0" />

        <DockPanel x:Name="StatusRow" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" FontSize="13.5" VerticalAlignment="Center" />
        </DockPanel>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="OnPickFiles">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static local:S.PickFiles}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{x:Static local:S.Close}" Click="OnClose" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
