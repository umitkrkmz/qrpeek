<Window x:Class="QRPeek.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QRPeek"
        Style="{StaticResource WindowBase}"
        Title="QRPeek" Width="460" Height="640" MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Icon="pack://application:,,,/Assets/QRPeek.ico">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
        <!-- Header -->
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnSettings" ToolTip="{x:Static local:S.Settings}"
                    AutomationProperties.Name="{x:Static local:S.Settings}"
                    VerticalAlignment="Top" Padding="8">
                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="17" />
            </Button>
            <Image Source="pack://application:,,,/Assets/QRPeek.png" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QRPeek" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static local:S.Tagline}" Style="{StaticResource Muted}" />
            </StackPanel>
        </DockPanel>

        <!-- Update available (GitHub build) -->
        <Border x:Name="UpdateBanner" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,8" Margin="0,-6,0,14" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{x:Static local:S.Download}" Click="OnDownloadUpdate" Padding="12,4" />
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>

        <!-- First run: the two shortcuts and where QRPeek lives -->
        <Border x:Name="WelcomeCard" Style="{StaticResource Card}" Margin="0,-6,0,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{x:Static local:S.WelcomeTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Grid x:Name="WelcomeRows">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock Text="{x:Static local:S.WelcomeTray}" Style="{StaticResource Muted}" Margin="0,4,0,10" />
                <Button Style="{StaticResource Primary}" Content="{x:Static local:S.WelcomeOk}" Click="OnWelcomeOk" HorizontalAlignment="Left" Padding="16,5" />
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Main action -->
        <Button Grid.Row="1" Style="{StaticResource Primary}" Click="OnScan" Padding="18,14" HorizontalContentAlignment="Stretch">
            <DockPanel>
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="24" Margin="0,0,14,0" />
                <Border x:Name="HotkeyBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                        Background="#33FFFFFF">
                    <TextBlock x:Name="HotkeyText" FontSize="12" FontWeight="Normal" TextWrapping="NoWrap" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static local:S.ScanScreen}" FontSize="16.5" />
                    <TextBlock Text="{x:Static local:S.ScanScreenHint}" FontSize="12.5" FontWeight="Normal" Opacity="0.85" />
                </StackPanel>
            </DockPanel>
        </Button>

        <!-- Secondary actions -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
            <Button Click="OnSelectRegion" Margin="0,0,5,10" Padding="12,10" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{x:Static local:S.SelectRegion}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="OnFromImage" Margin="5,0,0,10" Padding="12,10" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{x:Static local:S.FromImage}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SendButton" Click="OnSend" Margin="0,0,5,0" Padding="12,10" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{x:Static local:S.SendOrReceive}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Click="OnCreate" Margin="5,0,0,0" Padding="12,10" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xED14;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{x:Static local:S.CreateQr}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Drop zone -->
        <Grid Grid.Row="3" Margin="0,10,0,0" Height="48">
            <Rectangle x:Name="DropFrame" RadiusX="8" RadiusY="8" Stroke="{DynamicResource Line}" StrokeThickness="1.5" StrokeDashArray="4 3" />
            <TextBlock Text="{x:Static local:S.DropHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12,0" />
        </Grid>

        <!-- History -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnExportInvoices" Padding="6,2" FontSize="12.5"
                        Foreground="{DynamicResource Accent}" Content="{x:Static local:S.ExportInvoices}" VerticalAlignment="Center" Visibility="Collapsed" />
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnClearHistory" Padding="6,2" FontSize="12.5"
                        Foreground="{DynamicResource FgMuted}" Content="{x:Static local:S.ClearHistory}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static local:S.History}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="HistoryList" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
