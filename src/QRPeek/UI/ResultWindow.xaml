<Window x:Class="QRPeek.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QRPeek"
        Style="{StaticResource WindowBase}"
        Title="QRPeek" Width="480" SizeToContent="Height" MaxHeight="680"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/QRPeek.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Border x:Name="CopiedBadge" DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="10"
                    Padding="10,3" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static local:S.AutoCopied}" FontSize="12.5" Foreground="{DynamicResource Accent}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Items" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="OnScanAgain" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static local:S.ScanScreen}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Click="OnSelectRegion">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static local:S.SelectRegion}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="{x:Static local:S.Close}" Click="OnClose" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
